      "source_refs": [
        {
          "comment_id": "comm_001692_제355조_1항_Ⅶ.2_120",
          "quote": "횡령행위가 종료되어 일단 기수가 된 후 다시 그 물건을 처분하는 행위는 그 횡령 행위에 의하여 이미 평가되어 버린 것으로 볼 수 있는 범위 내인 한 이른바 불가 벌적 사후행위로서 별도의 횡령죄가 성립하지 않는다.",
          "section_path": "Ⅶ.2"
        }
      ],
      "variant_group": "art355_sec7_2.subsequent_disposal"
    },
