{
  "card_set_id": "kr.art329.art329.sec2_2.norms.v1",
  "cards": [
    {
      "authority_basis": "commentary_synthesis",
      "candidate_refs": [
        {
          "candidate_id": "theft.definition-criminal-possession",
          "request_id": "art329.pass1.001"
        }
      ],
      "doctrinal_status": "descriptive",
      "formalization": "deterministic_rule",
      "id": "art329_sec2_2.criminal_possession_definition",
      "norm_kind": "definition",
      "polarity": "positive",
      "proposition": "형법상 점유는 재물에 대한 현실적이고 순수한 사실상 지배관계이며 민법상 점유와 반드시 일치하지 않는다.",
      "request_ids": [
        "art329.pass1.001"
      ],
      "review_notes": "형법상 점유 개념의 기본 정의로 사용한다.",
      "review_required": false,
      "source_refs": [
        {
          "comment_id": "comm_001692_제329조_Ⅱ.2_4",
          "quote": "형법상 점유는 현실적으로 어떠한 재물을 지배하는 순수한 사실상 (Gewahrsam) 의 관계를 말하고, 민법상의 점유의 개념과 반드시 일치하지 않는다.",
          "section_path": "Ⅱ.2"
        }
      ],
      "variant_group": null
    },
    {
      "authority_basis": "commentary_synthesis",
      "candidate_refs": [
        {
          "candidate_id": "theft.standard-possession-factual-control-social-norms",
          "request_id": "art329.pass1.001"
        }
      ],
      "doctrinal_status": "settled",
      "formalization": "standard_input",
      "id": "art329_sec2_2.possession_factual_control_standard",
      "norm_kind": "standard",
      "polarity": "positive",
      "proposition": "형법상 재물의 사실상 지배 여부는 재물의 크기·형상·개성 및 점유자와 재물의 시간적·장소적 관계 등을 종합하여 사회통념에 따라 판단한다.",
      "request_ids": [
        "art329.pass1.001"
      ],
      "review_notes": "사실상 지배 판단에는 재물 및 시간적·장소적 관계에 대한 평가가 필요하다.",
      "review_required": true,
      "source_refs": [
        {
          "comment_id": "comm_001692_제329조_Ⅱ.2_4",
          "quote": "재물을 사실상으로 (監守) 지배하는지 여부는 재물의 크기·형상, 그 개성의 유무, 점유자와 재물과의 시간 적·장소적 관계 등을 종합하여 사회통념에 비추어 판단해야 한다.",
          "section_path": "Ⅱ.2"
        }
      ],
      "variant_group": null
    },
    {
      "authority_basis": "commentary_synthesis",
      "candidate_refs": [
        {
          "candidate_id": "theft.element-unlawful-possession-is-protected",
          "request_id": "art329.pass1.001"
        }
      ],
      "doctrinal_status": "settled",
      "formalization": "deterministic_rule",
      "id": "art329_sec2_2.unlawful_possession_protected",
      "norm_kind": "element",
      "polarity": "positive",
      "proposition": "점유는 적법한 권원에 기초할 필요가 없고, 권원 없는 자라도 현실적 실력지배가 있으면 그 점유는 절도죄의 객체로 보호된다.",
      "request_ids": [
        "art329.pass1.001"
      ],
      "review_notes": "점유 보호가 민사상 적법한 권원에 한정되지 않는다는 점을 명시한다.",
      "review_required": false,
      "source_refs": [
        {
          "comment_id": "comm_001692_제329조_Ⅱ.2_4",
          "quote": "점유는 반드시 권원에 의한 적법한 점유만을 의미하지 않는다.",
          "section_path": "Ⅱ.2"
        },
        {
          "comment_id": "comm_001692_제329조_Ⅱ.2_4",
          "quote": "점유할 권원 없는 자의 점유도 절도의 객체가 되므로",
          "section_path": "Ⅱ.2"
        }
      ],
      "variant_group": null
    },
    {
      "authority_basis": "commentary_reported_precedent",
      "candidate_refs": [
        {
          "candidate_id": "theft.standard-possession-assistant-factual-control",
          "request_id": "art329.pass1.001"
        }
      ],
      "doctrinal_status": "precedent_position",
      "formalization": "standard_input",
      "id": "art329_sec2_2.possession_assistant_control",
      "norm_kind": "standard",
      "polarity": "positive",
      "proposition": "점유보조자라도 물건에 대한 사실상 지배를 가지면 영득행위는 횡령의 죄책을 질 수 있어 절도죄가 되지 않지만, 단지 본점유자의 지시·감독 아래 소지 또는 감수할 뿐이면 형법상 점유자가 아니어서 절도죄가 성립한다는 것이 소개된 판례 태도이다.",
      "request_ids": [
        "art329.pass1.001"
      ],
      "review_notes": "점유보조자의 사실상 지배 정도와 지시·감독 관계는 구체적 사실에 따라 검토해야 한다.",
      "review_required": true,
      "source_refs": [
        {
          "comment_id": "comm_001692_제329조_Ⅱ.2_10",
          "quote": "점유 보조기관이라도 물건에 대한 사 실상의 지배를 가지고 있는 이상 이를 영득한 경우에 그 점유자로서 횡령의 죄 책을 질지언정 절도죄는 되지 않으나",
          "section_path": "Ⅱ.2"
        },
        {
          "comment_id": "comm_001692_제329조_Ⅱ.2_10",
          "quote": "물건이 점유자 본인의 사실상 지배하에 있고 점유보조자는 단지 점유자 본인의 지시·감독하에 소지 내지 감수하는 것 에 지나지 않는 경우에는 형법상 점유자가 아니므로 절도죄가 성립된다고 하는 것이 판례의 태도",
          "section_path": "Ⅱ.2"
        }
      ],
      "variant_group": null
    },
