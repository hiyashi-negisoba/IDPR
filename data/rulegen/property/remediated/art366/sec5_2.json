      "request_ids": [
        "art366.pass1.004"
      ],
      "review_notes": "댓글에 보고된 구체적 정당행위 인정 사례이며, 원판결 확인 전에는 보고된 판례로만 취급한다.",
      "review_required": true,
      "source_refs": [
        {
