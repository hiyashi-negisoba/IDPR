      "doctrinal_status": "descriptive",
      "formalization": "deterministic_rule",
      "id": "art366.electronic_record_definition",
      "norm_kind": "definition",
      "polarity": "positive",
      "proposition": "전자기록은 일정한 물질적 매체에 전자적 또는 자기적 방식으로 저장된 기록을 말한다.",
      "request_ids": [
        "art366.pass1.001"
      ],
      "review_notes": "전자기록의 매체 및 저장 방식에 관한 정의 카드다.",
      "review_required": false,
      "source_refs": [
        {
          "comment_id": "comm_001692_제366조_Ⅲ.1_10",
          "quote": "전자기록이라 함은 일정한 물질적 매체에 전자적 방식 또는 자기적 (electronic) 방식으로 저장된 기록, 즉 전자적 기록 또는 자기적 기록을 말한다.",
          "section_path": "Ⅲ.1"
        }
      ],
      "variant_group": null
    },
    {
      "authority_basis": "commentary_reported_precedent",
      "candidate_refs": [
        {
          "candidate_id": "art366.exception.information-itself-not-property",
          "request_id": "art366.pass1.001"
