      "doctrinal_status": "descriptive",
      "formalization": "standard_input",
      "id": "art343_sec2.preparation_definition",
      "norm_kind": "definition",
      "polarity": "positive",
      "proposition": "예비는 범죄의 의사로 이를 실현하기 위하여 하는 모든 준비행위로서, 아직 실행에 착수하기 전 단계의 행위이다.",
      "request_ids": [
        "art343.pass1.001"
      ],
      "review_notes": "준비행위와 실행의 착수의 구별에는 구체적 사실관계에 대한 평가가 필요하다.",
      "review_required": false,
      "source_refs": [
        {
          "comment_id": "comm_001692_제343조_Ⅱ_1",
          "quote": "‘예비’는 죄를 범할 의사로서 이를 실현하기 위해서 하는 모든 준비행위를 말하 며 아직 실행에 착수하기 전의 단계에 있는 행위이다.",
          "section_path": "Ⅱ"
        }
      ],
      "variant_group": null
    },
    {
      "authority_basis": "commentary_synthesis",
      "candidate_refs": [
        {
          "candidate_id": "art343.definition.conspiracy",
          "request_id": "art343.pass1.001"
