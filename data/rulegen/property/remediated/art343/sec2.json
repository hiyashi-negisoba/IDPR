      ],
      "doctrinal_status": "descriptive",
      "formalization": "standard_input",
      "id": "art343_sec2.conspiracy_definition",
      "norm_kind": "definition",
      "polarity": "positive",
      "proposition": "음모는 2인 이상이 범죄실행에 관하여 상호 합의하여 특정 범죄를 범할 공동의 의사를 형성하는 것이다.",
      "request_ids": [
        "art343.pass1.001"
      ],
      "review_notes": "상호 합의 및 특정 범죄에 관한 공동의사의 형성 여부는 대화와 정황을 통해 평가한다.",
      "review_required": false,
      "source_refs": [
        {
          "comment_id": "comm_001692_제343조_Ⅱ_1",
          "quote": "‘음모’는 2인 이상의 자가 범죄실행에 관하여 상호 합의하는 것을 말한다. 즉 통모 또는 공모에 의하여 특 정의 범죄를 범할 공동의 의사를 형성하는 것",
          "section_path": "Ⅱ"
        }
      ],
      "variant_group": null
    },
