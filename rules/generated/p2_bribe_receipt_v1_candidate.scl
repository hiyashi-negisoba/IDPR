// rule_id: bribe_receipt.card.art129_extortion_without_duty_or_consideration.satisfied
// sources: comm_001692_제129조_Ⅰ.6_17, comm_001692_제129조_Ⅰ.6_17
// norm_cards: art129.extortion_without_duty_or_consideration
rel satisfied_art129_extortion_without_duty_or_consideration(case_id, defendant_id, benefit_id, official_duty_id, giver_id) = assess_art129_extortion_without_duty_or_consideration(case_id, assessment_001, defendant_id, benefit_id, official_duty_id, giver_id, "satisfied") and
  provable(case_id, assessment_001)

// rule_id: bribe_receipt.card.art129_extortion_without_duty_or_consideration.undetermined
// sources: comm_001692_제129조_Ⅰ.6_17, comm_001692_제129조_Ⅰ.6_17
