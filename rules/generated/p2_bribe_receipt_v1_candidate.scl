rel bribe_receipt_undetermined(case_id, defendant_id, "art129.extortion_without_duty_or_consideration") = assess_art129_extortion_without_duty_or_consideration(case_id, unknown_001, defendant_id, benefit_id, official_duty_id, giver_id, "unknown") and
  provable(case_id, unknown_001)

