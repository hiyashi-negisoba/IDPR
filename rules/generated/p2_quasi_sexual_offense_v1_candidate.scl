// rule_id: quasi_sexual_offense.card.art299_attempt_commencement.satisfied
// sources: comm_001692_제299조_Ⅳ_8, comm_001692_제299조_Ⅳ_8
// norm_cards: art299.attempt_commencement
rel satisfied_art299_attempt_commencement(case_id, defendant_id, victim_id) = assess_art299_attempt_commencement(case_id, assessment_001, defendant_id, victim_id, "satisfied") and
  provable(case_id, assessment_001)

// rule_id: quasi_sexual_offense.card.art299_attempt_commencement.undetermined
// sources: comm_001692_제299조_Ⅳ_8, comm_001692_제299조_Ⅳ_8
// norm_cards: art299.attempt_commencement
rel quasi_sexual_offense_undetermined(case_id, defendant_id, "art299.attempt_commencement") = assess_art299_attempt_commencement(case_id, unknown_001, defendant_id, victim_id, "unknown") and
  provable(case_id, unknown_001)

// rule_id: quasi_sexual_offense.card.art299_attempt_commencement.conflict
// sources: comm_001692_제299조_Ⅳ_8, comm_001692_제299조_Ⅳ_8
// norm_cards: art299.attempt_commencement
rel quasi_sexual_offense_conflict(case_id, defendant_id, "art299.attempt_commencement") = assess_art299_attempt_commencement(case_id, positive_001, defendant_id, victim_id, "satisfied") and
  assess_art299_attempt_commencement(case_id, negative_001, defendant_id, victim_id, "not_satisfied") and
  provable(case_id, positive_001) and
  provable(case_id, negative_001)

