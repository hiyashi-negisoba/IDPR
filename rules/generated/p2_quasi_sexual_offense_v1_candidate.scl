  provable(case_id, unknown_002)

// rule_id: quasi_sexual_offense.card.art299_offense_characterization.conflict
// sources: comm_001692_제299조_Ⅰ_0
// norm_cards: art299.offense_characterization
rel quasi_sexual_offense_conflict(case_id, defendant_id, "art299.offense_characterization") = assess_art299_offense_characterization(case_id, positive_002, defendant_id, victim_id, "satisfied") and
  assess_art299_offense_characterization(case_id, negative_002, defendant_id, victim_id, "not_satisfied") and
  provable(case_id, positive_002) and
  provable(case_id, negative_002)

