// provable: 해당 사건의 평가가 절차·증명 게이트를 통과하여 실체법 규칙에 사용될 수 있음
// sources: system contract
// norm_cards: system contract
type provable(String, String)

// case_assessment_complete: 사건 라우터가 선택한 평가 묶음이 완결되어 결론 계층의 폐쇄세계 검사를 허용함
// sources: system contract
// norm_cards: system contract
type case_assessment_complete(String, String)

// distinct_entity: 사건의 entity resolution에서 두 역할이 서로 다른 실체임이 확인됨
// sources: system contract
// norm_cards: system contract
type distinct_entity(String, String, String)

// relative_property_exception_case_roles: 재산죄 행위자, 목적물, 소유자·점유자, 전제 재산죄 outcome의 역할 tuple
// sources: system contract
// norm_cards: system contract
type relative_property_exception_case_roles(String, String, String, String, String, String)

// relative_property_crime_exception_not_established: 증명된 불성립 사유 또는 경계 이동이 존재함
// sources: system contract
// norm_cards: system contract
type relative_property_crime_exception_not_established(String, String, String)

// relative_property_crime_exception_undetermined: 관련 카드의 평가가 unknown이어서 결론을 확정할 수 없음
// sources: system contract
// norm_cards: system contract
type relative_property_crime_exception_undetermined(String, String, String)

// relative_property_crime_exception_conflict: 같은 카드에 satisfied와 not_satisfied 평가가 모두 증명됨
// sources: system contract
// norm_cards: system contract
type relative_property_crime_exception_conflict(String, String, String)

// relative_property_crime_exception_track_not_established: 해당 track에만 적용되는 증명된 불성립 사유 또는 경계 이동
// sources: system contract
// norm_cards: system contract
type relative_property_crime_exception_track_not_established(String, String, String, String)

// relative_property_crime_exception_track_conflict: 해당 track에 적용되는 카드 평가 충돌
// sources: system contract
// norm_cards: system contract
type relative_property_crime_exception_track_conflict(String, String, String, String)

// relative_property_crime_exception_track_has_negative: 해당 track에 증명된 불성립 사유가 존재함
// sources: system contract
// norm_cards: system contract
type relative_property_crime_exception_track_has_negative(String, String, String)

// relative_property_crime_exception_track_has_conflict: 해당 track에 증명된 평가 충돌이 존재함
// sources: system contract
// norm_cards: system contract
type relative_property_crime_exception_track_has_conflict(String, String, String)

// assess_art344_x_raw_pdf_article328_theft_offenses_scope: 이 카드의 사건별 적용 평가: 형법 제328조의 친족상도례 규정은 절도·야간주거침입절도·특수절도·자동차등불법사용 및 상습범과 그 미수범에 한하여 준용된다.
// sources: raw_001692_제344조_p001
// norm_cards: art344_x_raw_pdf.article328_theft_offenses_scope
