// rule_id: relative_property_crime_exception.summary.has_negative
// sources: raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001
// norm_cards: art344_x_raw_pdf.article328_theft_offenses_scope, art344_x_raw_pdf.kinship_only_one_holder_no_application, art344_x_raw_pdf.kinship_with_owner_and_possessor, art344_x_raw_pdf.robbery_no_family_benefit
rel relative_property_crime_exception_has_negative(case_id, defendant_id) = relative_property_crime_exception_not_established(case_id, defendant_id, norm_card_id)

// rule_id: relative_property_crime_exception.summary.has_conflict
// sources: raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001
// norm_cards: art344_x_raw_pdf.article328_theft_offenses_scope, art344_x_raw_pdf.kinship_only_one_holder_no_application, art344_x_raw_pdf.kinship_with_owner_and_possessor, art344_x_raw_pdf.robbery_no_family_benefit
rel relative_property_crime_exception_has_conflict(case_id, defendant_id) = relative_property_crime_exception_conflict(case_id, defendant_id, norm_card_id)

// rule_id: relative_property_crime_exception.summary.canonical_not_established
// sources: raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001
// norm_cards: art344_x_raw_pdf.article328_theft_offenses_scope, art344_x_raw_pdf.kinship_only_one_holder_no_application, art344_x_raw_pdf.kinship_with_owner_and_possessor, art344_x_raw_pdf.robbery_no_family_benefit
rel relative_property_crime_exception_not_established(case_id, defendant_id, norm_card_id) = relative_property_crime_exception_track_not_established(case_id, defendant_id, track_id, norm_card_id)

// rule_id: relative_property_crime_exception.summary.track_has_negative
// sources: raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001
// norm_cards: art344_x_raw_pdf.article328_theft_offenses_scope, art344_x_raw_pdf.kinship_only_one_holder_no_application, art344_x_raw_pdf.kinship_with_owner_and_possessor, art344_x_raw_pdf.robbery_no_family_benefit
rel relative_property_crime_exception_track_has_negative(case_id, defendant_id, track_id) = relative_property_crime_exception_track_not_established(case_id, defendant_id, track_id, norm_card_id)

// rule_id: relative_property_crime_exception.summary.track_has_conflict
// sources: raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001
// norm_cards: art344_x_raw_pdf.article328_theft_offenses_scope, art344_x_raw_pdf.kinship_only_one_holder_no_application, art344_x_raw_pdf.kinship_with_owner_and_possessor, art344_x_raw_pdf.robbery_no_family_benefit
rel relative_property_crime_exception_track_has_conflict(case_id, defendant_id, track_id) = relative_property_crime_exception_track_conflict(case_id, defendant_id, track_id, norm_card_id)

// rule_id: relative_property_crime_exception.outcome.exception.elements_satisfied
// sources: raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001
// norm_cards: art344_x_raw_pdf.article328_theft_offenses_scope, art344_x_raw_pdf.kinship_only_one_holder_no_application, art344_x_raw_pdf.kinship_with_owner_and_possessor, art344_x_raw_pdf.robbery_no_family_benefit
rel relative_property_crime_exception_exception_elements_satisfied(case_id, defendant_id, property_id, owner_id, possessor_id, predicate_offense_id) = relative_property_crime_exception_exception_eligible_property_offense_satisfied(case_id, defendant_id, property_id, owner_id, possessor_id, predicate_offense_id) and
  relative_property_crime_exception_exception_kinship_with_owner_and_possessor_satisfied(case_id, defendant_id, property_id, owner_id, possessor_id, predicate_offense_id)

// rule_id: relative_property_crime_exception.outcome.exception.established
// sources: raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001, raw_001692_제344조_p001
// norm_cards: art344_x_raw_pdf.article328_theft_offenses_scope, art344_x_raw_pdf.kinship_only_one_holder_no_application, art344_x_raw_pdf.kinship_with_owner_and_possessor, art344_x_raw_pdf.robbery_no_family_benefit
rel relative_property_crime_exception_exception_established(case_id, defendant_id, property_id, owner_id, possessor_id, predicate_offense_id) = relative_property_crime_exception_exception_elements_satisfied(case_id, defendant_id, property_id, owner_id, possessor_id, predicate_offense_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~relative_property_crime_exception_track_has_negative(case_id, defendant_id, "exception") and
  ~relative_property_crime_exception_track_has_conflict(case_id, defendant_id, "exception")
