// sources: comm_001692_제122조_Ⅱ.5_17, comm_001692_제122조_Ⅱ.5_17
// norm_cards: art122_sec2_5.instigation_per_public_official
type satisfied_art122_sec2_5_instigation_per_public_official(String, String, String)

