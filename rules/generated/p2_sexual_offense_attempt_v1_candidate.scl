rel sexual_offense_attempt_track_conflict(case_id, defendant_id, "attempt", "art300_x_raw_pdf.enumerated_offenses_attempts") = sexual_offense_attempt_conflict(case_id, defendant_id, "art300_x_raw_pdf.enumerated_offenses_attempts")

// rule_id: sexual_offense_attempt.track_conflict.attempt.art300_x_raw_pdf_other_offenses_exclusion
