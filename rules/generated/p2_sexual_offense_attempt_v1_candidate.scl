// norm_cards: art300_x_raw_pdf.other_offenses_exclusion
rel sexual_offense_attempt_track_conflict(case_id, defendant_id, "attempt", "art300_x_raw_pdf.other_offenses_exclusion") = sexual_offense_attempt_conflict(case_id, defendant_id, "art300_x_raw_pdf.other_offenses_exclusion")

// rule_id: sexual_offense_attempt.track_blocked.attempt.art300_x_raw_pdf_other_offenses_exclusion
