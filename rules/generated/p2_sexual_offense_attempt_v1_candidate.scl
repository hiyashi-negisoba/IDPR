// norm_cards: art300_x_raw_pdf.art305_under_sixteen_attempt_interpretation, art300_x_raw_pdf.commencement_of_execution, art300_x_raw_pdf.enumerated_offenses_attempts, art300_x_raw_pdf.other_offenses_exclusion, art300_x_raw_pdf.pre_amendment_art305_under_thirteen_attempt
rel sexual_offense_attempt_has_conflict(case_id, defendant_id) = sexual_offense_attempt_conflict(case_id, defendant_id, norm_card_id)

