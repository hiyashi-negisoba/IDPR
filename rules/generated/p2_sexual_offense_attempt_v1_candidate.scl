rel sexual_offense_attempt_track_not_established(case_id, defendant_id, "attempt", "art300_x_raw_pdf.other_offenses_exclusion") = satisfied_art300_x_raw_pdf_other_offenses_exclusion(case_id, defendant_id, victim_id)

