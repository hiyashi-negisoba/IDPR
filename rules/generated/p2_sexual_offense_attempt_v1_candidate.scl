// norm_cards: art300_x_raw_pdf.art305_under_sixteen_attempt_interpretation, art300_x_raw_pdf.commencement_of_execution, art300_x_raw_pdf.enumerated_offenses_attempts, art300_x_raw_pdf.other_offenses_exclusion, art300_x_raw_pdf.pre_amendment_art305_under_thirteen_attempt
rel sexual_offense_attempt_track_has_conflict(case_id, defendant_id, track_id) = sexual_offense_attempt_track_conflict(case_id, defendant_id, track_id, norm_card_id)

// rule_id: sexual_offense_attempt.outcome.attempt.elements_satisfied
// sources: raw_001692_제300조_p002, raw_001692_제300조_p002, raw_001692_제300조_p002, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p002, raw_001692_제300조_p002, raw_001692_제300조_p002
// norm_cards: art300_x_raw_pdf.art305_under_sixteen_attempt_interpretation, art300_x_raw_pdf.commencement_of_execution, art300_x_raw_pdf.enumerated_offenses_attempts, art300_x_raw_pdf.other_offenses_exclusion, art300_x_raw_pdf.pre_amendment_art305_under_thirteen_attempt
rel sexual_offense_attempt_attempt_elements_satisfied(case_id, defendant_id, victim_id) = sexual_offense_attempt_attempt_commencement_satisfied(case_id, defendant_id, victim_id) and
  sexual_offense_attempt_attempt_eligible_predicate_offense_satisfied(case_id, defendant_id, victim_id)

// rule_id: sexual_offense_attempt.outcome.attempt.established
// sources: raw_001692_제300조_p002, raw_001692_제300조_p002, raw_001692_제300조_p002, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p001, raw_001692_제300조_p002, raw_001692_제300조_p002, raw_001692_제300조_p002
// norm_cards: art300_x_raw_pdf.art305_under_sixteen_attempt_interpretation, art300_x_raw_pdf.commencement_of_execution, art300_x_raw_pdf.enumerated_offenses_attempts, art300_x_raw_pdf.other_offenses_exclusion, art300_x_raw_pdf.pre_amendment_art305_under_thirteen_attempt
rel sexual_offense_attempt_attempt_established(case_id, defendant_id, victim_id) = sexual_offense_attempt_attempt_elements_satisfied(case_id, defendant_id, victim_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~sexual_offense_attempt_track_has_negative(case_id, defendant_id, "attempt") and
  ~sexual_offense_attempt_track_has_conflict(case_id, defendant_id, "attempt")
