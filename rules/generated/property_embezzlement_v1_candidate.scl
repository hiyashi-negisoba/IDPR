// norm_cards: art355.embezzlement.document-embodied-right, art355.embezzlement.object-identification, art355.embezzlement.object-other-property, art355.embezzlement.other-person, art355.embezzlement_custody, art355.embezzlement_protectable_entrustment, art355_sec1_1.simple_embezzlement, art355_sec1_2.embezzlement_illegal_appropriation_theory, art355_sec2_1.embezzlement_object_property, art355_sec3_3.authority_excess_theory, art355_sec3_3.company_funds_advance_loan, art355_sec3_3.company_funds_private_use, art355_sec3_3.completion_expression_theory, art355_sec3_3.coownership_whole_property, art355_sec3_3.embezzlement_act, art355_sec3_3.invalid_disposition_majority, art355_sec3_3.legal_disposition, art355_sec3_3.money_fungibles_consumed_amount, art355_sec3_3.objective_manifestation, art355_sec3_3.omission_embezzlement, art355_sec3_3.partnership_joint_property_whole_amount, art355_sec3_3.purpose_limited_money_setoff, art355_sec3_3.refusal_equivalent_to_embezzlement, art355_sec3_3.refusal_to_return, art355_sec4_1.embezzlement_intent_objective_elements, art355_sec4_1.eventual_intent_elements, art355_sec4_1.eventual_intent_inference, art355_sec4_1.illegal_appropriation_intent_definition, art355_sec4_1.illegal_appropriation_intent_ownerlike_disposition, art355_sec4_1.repayment_intent_no_exclusion, art355_sec4_1.temporary_company_fund_objective_assessment_view, art355_sec4_2.embezzlement_illicit_appropriation, art355_sec4_2.restricted_funds_off_purpose_embezzlement, art355_sec4_2.temporary_use_against_entrustment, art355_sec4_2.third_party_appropriation, art355_sec4_3.budget_diversion_restricted, art355_sec4_3.business_expense_personal_or_excessive, art355_sec4_3.fake_capital_real_increase_assessment, art355_sec4_3.restricted_budget_assessment, art355_sec4_3.slush_fund_definition, art355_sec4_3.slush_fund_formation_personal_appropriation, art355_sec4_3.slush_fund_purpose_assessment
rel embezzlement_established(case_id, defendant_id, entrustor_id, owner_id) = embezzlement_elements_satisfied(case_id, defendant_id, entrustor_id, owner_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~embezzlement_has_negative(case_id, defendant_id) and
  ~embezzlement_has_conflict(case_id, defendant_id)

// rule_id: embezzlement.art355_sec3_3.requirement_waived.001
// sources: comm_001692_제355조_1항_Ⅲ.3_76
// norm_cards: art355_sec3_3.deceptive_means_no_fraud
rel embezzlement_requirement_waived(case_id, defendant_id, "art355_sec3_3.deceptive_means_no_fraud") = satisfied_art355_sec3_3_deceptive_means_no_fraud(case_id, defendant_id, entrustor_id, owner_id)

// rule_id: embezzlement.art355_sec3_3.requirement_waived.002
// sources: comm_001692_제355조_1항_Ⅲ.3_84
// norm_cards: art355_sec3_3.no_property_damage_element
rel embezzlement_requirement_waived(case_id, defendant_id, "art355_sec3_3.no_property_damage_element") = satisfied_art355_sec3_3_no_property_damage_element(case_id, defendant_id, entrustor_id, owner_id)

// rule_id: embezzlement.aggravation.occupational.001
// sources: comm_001692_제356조_Ⅲ.1_3
// norm_cards: art356.business_possession_definition
rel embezzlement_aggravation(case_id, defendant_id, "occupational") = embezzlement_established(case_id, defendant_id, entrustor_id, owner_id) and
  satisfied_art356_business_possession_definition(case_id, defendant_id, entrustor_id, owner_id)

// rule_id: embezzlement.aggravation.occupational.002
// sources: comm_001692_제356조_Ⅲ.1_3
// norm_cards: art356.business_possession_origins
rel embezzlement_aggravation(case_id, defendant_id, "occupational") = embezzlement_established(case_id, defendant_id, entrustor_id, owner_id) and
  satisfied_art356_business_possession_origins(case_id, defendant_id, entrustor_id, owner_id)

// rule_id: embezzlement.aggravation.occupational.003
// sources: comm_001692_제356조_Ⅲ.1_3
// norm_cards: art356.possession_business_nexus
rel embezzlement_aggravation(case_id, defendant_id, "occupational") = embezzlement_established(case_id, defendant_id, entrustor_id, owner_id) and
  satisfied_art356_possession_business_nexus(case_id, defendant_id, entrustor_id, owner_id)

// rule_id: embezzlement.aggravation.occupational.004
// sources: comm_001692_제356조_Ⅱ.2_2
// norm_cards: art356_sec2_2.unrelated_possession
rel embezzlement_aggravation(case_id, defendant_id, "occupational") = embezzlement_established(case_id, defendant_id, entrustor_id, owner_id) and
  satisfied_art356_sec2_2_unrelated_possession(case_id, defendant_id, entrustor_id, owner_id)

