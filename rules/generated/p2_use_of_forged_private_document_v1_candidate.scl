// norm_cards: art234.attempt_punishable, art234.completion_by_placement_or_mail_delivery, art234.forged_license_possession_and_driving_not_utterance, art234.offense_character, art234_sec2_1.copies_and_electronic_transmission, art234_sec2_1.counterparty_interest_and_lack_of_knowledge, art234_sec2_1.exercise_of_document, art234_sec2_1.exercise_of_special_media_record, art234_sec2_1.indirect_perpetration_tool_holder, art234_sec2_1.methods_of_exercise, art234_sec2_1.object_covered_documents, art234_sec2_1.possession_before_offer_not_exercise, art234_sec2_1.presentation_to_knowing_accomplice, art234_sec2_1.transcript_not_exercise, art234_sec2_1.use_as_forgery_not_exercise, art234_sec2_2.intent_no_purpose, art234_sec4.company_agreement_breach_ideal_concurrence, art234_sec4.forger_and_exercise_real_concurrence, art234_sec4.multiple_documents_ideal_concurrence
rel use_of_forged_private_document_base_established(case_id, defendant_id, document_id, counterparty_id) = use_of_forged_private_document_base_elements_satisfied(case_id, defendant_id, document_id, counterparty_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~use_of_forged_private_document_track_has_negative(case_id, defendant_id, "base") and
  ~use_of_forged_private_document_track_has_conflict(case_id, defendant_id, "base")
