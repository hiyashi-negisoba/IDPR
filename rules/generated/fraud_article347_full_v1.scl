rel fraud_established(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) = fraud_elements_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~fraud_has_negative(case_id, defendant_id) and
  ~fraud_has_conflict(case_id, defendant_id)
