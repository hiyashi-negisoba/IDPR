rel fraud_elements_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) = fraud_object_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_deception_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_mistake_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_disposition_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_acquisition_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_causal_chain_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_completion_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_intent_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_role_structure_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id) and
  fraud_beneficiary_attribution_satisfied(case_id, defendant_id, deceived_person_id, deceived_person_id, property_owner_id, beneficiary_id)

