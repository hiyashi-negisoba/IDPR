rel official_secret_disclosure_base_established(case_id, defendant_id, secret_id, recipient_id) = official_secret_disclosure_base_elements_satisfied(case_id, defendant_id, secret_id, recipient_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~official_secret_disclosure_track_has_negative(case_id, defendant_id, "base") and
  ~official_secret_disclosure_track_has_conflict(case_id, defendant_id, "base")
