// sources: comm_001692_제227조_Ⅳ.2_14, comm_001692_제227조_Ⅳ.2_14
// norm_cards: art227_sec4_2.false_reinvestigation_statements
type satisfied_art227_sec4_2_false_reinvestigation_statements(String, String, String, String)

