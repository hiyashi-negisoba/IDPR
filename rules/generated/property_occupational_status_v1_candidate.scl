rel not_satisfied_satisfied_art356_sec3_3_status_awareness(case_id, defendant_id) = assess_art356_sec3_3_status_awareness(case_id, not_satisfied_010, defendant_id, "not_satisfied") and
  provable(case_id, not_satisfied_010)

// rule_id: occupational_status.art356.component.occupational_status_object_satisfied.01
// sources: comm_001692_제356조_Ⅰ_0
// norm_cards: art356.dual_status
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_dual_status(case_id, defendant_id)

// rule_id: occupational_status.art356.component.occupational_status_object_satisfied.02
// sources: comm_001692_제356조_Ⅰ_0
// norm_cards: art356.offense_character
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_offense_character(case_id, defendant_id)

// rule_id: occupational_status.art356_sec2_1.component.occupational_status_object_satisfied.03
// sources: comm_001692_제356조_Ⅱ.1_1
// norm_cards: art356_sec2_1.business_continuity_status
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_sec2_1_business_continuity_status(case_id, defendant_id)

// rule_id: occupational_status.art356_sec2_1.component.occupational_status_object_satisfied.04
// sources: comm_001692_제356조_Ⅱ.1_1
// norm_cards: art356_sec2_1.business_definition
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_sec2_1_business_definition(case_id, defendant_id)

// rule_id: occupational_status.art356_sec2_1.component.occupational_status_object_satisfied.05
// sources: comm_001692_제356조_Ⅱ.1_1
// norm_cards: art356_sec2_1.business_no_livelihood_or_formal_office
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_sec2_1_business_no_livelihood_or_formal_office(case_id, defendant_id)

// rule_id: occupational_status.art356_sec2_1.component.occupational_status_object_satisfied.06
// sources: comm_001692_제356조_Ⅱ.1_1
// norm_cards: art356_sec2_1.employee_assistant_business_status
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_sec2_1_employee_assistant_business_status(case_id, defendant_id)

// rule_id: occupational_status.art356_sec2_1.component.occupational_status_object_satisfied.07
// sources: comm_001692_제356조_Ⅱ.1_1
// norm_cards: art356_sec2_1.incidental_business_relation
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_sec2_1_incidental_business_relation(case_id, defendant_id)

// rule_id: occupational_status.art356_sec2_2.component.occupational_status_object_satisfied.08
// sources: comm_001692_제356조_Ⅱ.2_2
// norm_cards: art356_sec2_2.administrative_illegality
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_sec2_2_administrative_illegality(case_id, defendant_id)

// rule_id: occupational_status.art356_sec3_3.component.occupational_status_object_satisfied.09
// sources: comm_001692_제356조_Ⅲ.3_5
// norm_cards: art356_sec3_3.status_awareness
rel occupational_status_object_satisfied(case_id, defendant_id) = satisfied_art356_sec3_3_status_awareness(case_id, defendant_id)

// rule_id: occupational_status.art356_sec2_2.bar.001
// sources: comm_001692_제356조_Ⅱ.2_2
// norm_cards: art356_sec2_2.illegal_business
rel occupational_status_not_established(case_id, defendant_id, "art356_sec2_2.illegal_business") = satisfied_art356_sec2_2_illegal_business(case_id, defendant_id)

// rule_id: occupational_status.component.l0.mandatory_negative.01
// sources: comm_001692_제356조_Ⅰ_0, comm_001692_제356조_Ⅰ_0, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.2_2, comm_001692_제356조_Ⅲ.3_5
// norm_cards: art356.dual_status, art356.offense_character, art356_sec2_1.business_continuity_status, art356_sec2_1.business_definition, art356_sec2_1.business_no_livelihood_or_formal_office, art356_sec2_1.employee_assistant_business_status, art356_sec2_1.incidental_business_relation, art356_sec2_2.administrative_illegality, art356_sec3_3.status_awareness
rel occupational_status_not_established(case_id, defendant_id, "occupational_status_object_satisfied") = not_satisfied_satisfied_art356_dual_status(case_id, defendant_id) and
  not_satisfied_satisfied_art356_offense_character(case_id, defendant_id) and
  not_satisfied_satisfied_art356_sec2_1_business_continuity_status(case_id, defendant_id) and
  not_satisfied_satisfied_art356_sec2_1_business_definition(case_id, defendant_id) and
  not_satisfied_satisfied_art356_sec2_1_business_no_livelihood_or_formal_office(case_id, defendant_id) and
  not_satisfied_satisfied_art356_sec2_1_employee_assistant_business_status(case_id, defendant_id) and
  not_satisfied_satisfied_art356_sec2_1_incidental_business_relation(case_id, defendant_id) and
  not_satisfied_satisfied_art356_sec2_2_administrative_illegality(case_id, defendant_id) and
  not_satisfied_satisfied_art356_sec3_3_status_awareness(case_id, defendant_id)

// rule_id: occupational_status.core.outcome.elements_satisfied
// sources: comm_001692_제356조_Ⅰ_0, comm_001692_제356조_Ⅰ_0, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.2_2, comm_001692_제356조_Ⅲ.3_5
// norm_cards: art356.dual_status, art356.offense_character, art356_sec2_1.business_continuity_status, art356_sec2_1.business_definition, art356_sec2_1.business_no_livelihood_or_formal_office, art356_sec2_1.employee_assistant_business_status, art356_sec2_1.incidental_business_relation, art356_sec2_2.administrative_illegality, art356_sec3_3.status_awareness
rel occupational_status_elements_satisfied(case_id, defendant_id) = occupational_status_object_satisfied(case_id, defendant_id)

// rule_id: occupational_status.core.outcome.has_negative
// sources: comm_001692_제356조_Ⅱ.2_2
// norm_cards: art356_sec2_2.illegal_business
rel occupational_status_has_negative(case_id, defendant_id) = occupational_status_not_established(case_id, defendant_id, negative_issue_id)

// rule_id: occupational_status.core.outcome.has_conflict
// sources: comm_001692_제356조_Ⅰ_0, comm_001692_제356조_Ⅰ_0, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.2_2, comm_001692_제356조_Ⅱ.2_2, comm_001692_제356조_Ⅲ.3_5
// norm_cards: art356.dual_status, art356.offense_character, art356_sec2_1.business_continuity_status, art356_sec2_1.business_definition, art356_sec2_1.business_no_livelihood_or_formal_office, art356_sec2_1.employee_assistant_business_status, art356_sec2_1.incidental_business_relation, art356_sec2_2.administrative_illegality, art356_sec2_2.illegal_business, art356_sec3_3.status_awareness
rel occupational_status_has_conflict(case_id, defendant_id) = occupational_status_conflict(case_id, defendant_id, conflict_issue_id)

// rule_id: occupational_status.core.outcome.established
// sources: comm_001692_제356조_Ⅰ_0, comm_001692_제356조_Ⅰ_0, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.1_1, comm_001692_제356조_Ⅱ.2_2, comm_001692_제356조_Ⅲ.3_5
// norm_cards: art356.dual_status, art356.offense_character, art356_sec2_1.business_continuity_status, art356_sec2_1.business_definition, art356_sec2_1.business_no_livelihood_or_formal_office, art356_sec2_1.employee_assistant_business_status, art356_sec2_1.incidental_business_relation, art356_sec2_2.administrative_illegality, art356_sec3_3.status_awareness
rel occupational_status_established(case_id, defendant_id) = occupational_status_elements_satisfied(case_id, defendant_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~occupational_status_has_negative(case_id, defendant_id) and
  ~occupational_status_has_conflict(case_id, defendant_id)
