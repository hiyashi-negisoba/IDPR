rel obstruction_of_official_duty_base_established(case_id, defendant_id, official_id, official_duty_id) = obstruction_of_official_duty_base_elements_satisfied(case_id, defendant_id, official_id, official_duty_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~obstruction_of_official_duty_track_has_negative(case_id, defendant_id, "base") and
  ~obstruction_of_official_duty_track_has_conflict(case_id, defendant_id, "base")

