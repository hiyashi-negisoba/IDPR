  obstruction_of_official_duty_official_coercion_official_object_satisfied(case_id, defendant_id, official_id, official_duty_id) and
  obstruction_of_official_duty_official_coercion_specific_purpose_satisfied(case_id, defendant_id, official_id, official_duty_id)

