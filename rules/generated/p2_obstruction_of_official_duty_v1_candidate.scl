rel obstruction_of_official_duty_official_coercion_elements_satisfied(case_id, defendant_id, official_id, official_duty_id) = obstruction_of_official_duty_official_coercion_coercion_definition_satisfied(case_id, defendant_id, official_id, official_duty_id) and
  obstruction_of_official_duty_official_coercion_coercive_conduct_satisfied(case_id, defendant_id, official_id, official_duty_id) and
