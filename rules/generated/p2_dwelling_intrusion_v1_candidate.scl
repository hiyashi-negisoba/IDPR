rel dwelling_intrusion_attempt_established(case_id, defendant_id, place_id, occupant_id) = dwelling_intrusion_attempt_elements_satisfied(case_id, defendant_id, place_id, occupant_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~dwelling_intrusion_track_has_negative(case_id, defendant_id, "attempt") and
  ~dwelling_intrusion_track_has_conflict(case_id, defendant_id, "attempt")

