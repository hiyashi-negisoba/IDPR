rel dwelling_intrusion_refusal_to_leave_elements_satisfied(case_id, defendant_id, place_id, occupant_id) = dwelling_intrusion_refusal_to_leave_ability_to_leave_satisfied(case_id, defendant_id, place_id, occupant_id) and
  dwelling_intrusion_refusal_to_leave_justified_demand_satisfied(case_id, defendant_id, place_id, occupant_id) and
