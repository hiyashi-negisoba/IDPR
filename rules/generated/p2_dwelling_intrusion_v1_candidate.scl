// norm_cards: art319_sec1_4.partial_body_attempt, art319_sec3_2.attempt_commencement, art319_sec3_2.attempt_construction_site_negative, art319_sec3_2.attempt_door_opening, art319_sec3_2.completion_minimal_partial_entry_attempt
rel dwelling_intrusion_attempt_elements_satisfied(case_id, defendant_id, place_id, occupant_id) = dwelling_intrusion_attempt_dangerous_commencement_satisfied(case_id, defendant_id, place_id, occupant_id)

// rule_id: dwelling_intrusion.outcome.attempt.established
// sources: comm_001692_제319조_Ⅰ.4_7, comm_001692_제319조_Ⅲ.2_41, comm_001692_제319조_Ⅲ.2_41, comm_001692_제319조_Ⅲ.2_41, comm_001692_제319조_Ⅲ.2_41, comm_001692_제319조_Ⅲ.2_41, comm_001692_제319조_Ⅲ.2_41, comm_001692_제319조_Ⅲ.2_41, comm_001692_제319조_Ⅲ.2_42
