rel homicide_preparation_elements_satisfied(case_id, defendant_id, victim_id) = homicide_preparation_conspiracy_agreement_satisfied(case_id, defendant_id, victim_id) and
  homicide_preparation_murder_purpose_satisfied(case_id, defendant_id, victim_id) and
