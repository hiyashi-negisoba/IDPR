rel homicide_parricide_established(case_id, defendant_id, victim_id) = homicide_parricide_elements_satisfied(case_id, defendant_id, victim_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~homicide_track_has_negative(case_id, defendant_id, "parricide") and
  ~homicide_track_has_conflict(case_id, defendant_id, "parricide")

