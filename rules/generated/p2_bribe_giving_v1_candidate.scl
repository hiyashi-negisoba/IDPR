  provable(case_id, assessment_002)

// rule_id: bribe_giving.card.art133_bribery_offering_offense.undetermined
// sources: comm_001692_제133조_Ⅰ.1_0
// norm_cards: art133.bribery_offering_offense
rel bribe_giving_undetermined(case_id, defendant_id, "art133.bribery_offering_offense") = assess_art133_bribery_offering_offense(case_id, unknown_002, defendant_id, benefit_id, official_id, intermediary_id, "unknown") and
  provable(case_id, unknown_002)

// rule_id: bribe_giving.card.art133_bribery_offering_offense.conflict
// sources: comm_001692_제133조_Ⅰ.1_0
// norm_cards: art133.bribery_offering_offense
rel bribe_giving_conflict(case_id, defendant_id, "art133.bribery_offering_offense") = assess_art133_bribery_offering_offense(case_id, positive_002, defendant_id, benefit_id, official_id, intermediary_id, "satisfied") and
  assess_art133_bribery_offering_offense(case_id, negative_002, defendant_id, benefit_id, official_id, intermediary_id, "not_satisfied") and
  provable(case_id, positive_002) and
  provable(case_id, negative_002)

// rule_id: bribe_giving.card.art133_sec1_2_acquisition.satisfied
