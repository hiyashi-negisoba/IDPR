rel seal_forgery_or_misuse_creation_or_misuse_elements_satisfied(case_id, defendant_id, mark_id, nominal_holder_id) = seal_forgery_or_misuse_creation_or_misuse_false_manifestation_satisfied(case_id, defendant_id, mark_id, nominal_holder_id) and
  seal_forgery_or_misuse_creation_or_misuse_intent_and_use_purpose_satisfied(case_id, defendant_id, mark_id, nominal_holder_id) and
