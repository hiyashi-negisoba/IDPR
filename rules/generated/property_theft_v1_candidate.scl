// rule_id: theft.art329_sec2.card.001.satisfied
// sources: comm_001692_제329조_Ⅱ_1
// norm_cards: art329_sec2.theft_exception_ownership_or_self_possession
rel satisfied_art329_sec2_theft_exception_ownership_or_self_possession(case_id, defendant_id, owner_id, possessor_id) = assess_art329_sec2_theft_exception_ownership_or_self_possession(case_id, assessment_001, defendant_id, owner_id, possessor_id, "satisfied") and
  provable(case_id, assessment_001)

// rule_id: theft.art329_sec2.card.001.undetermined
// sources: comm_001692_제329조_Ⅱ_1
// norm_cards: art329_sec2.theft_exception_ownership_or_self_possession
rel theft_undetermined(case_id, defendant_id, "art329_sec2.theft_exception_ownership_or_self_possession") = assess_art329_sec2_theft_exception_ownership_or_self_possession(case_id, unknown_assessment_001, defendant_id, owner_id, possessor_id, "unknown") and
  provable(case_id, unknown_assessment_001)

// rule_id: theft.art329_sec2.card.001.conflict
// sources: comm_001692_제329조_Ⅱ_1
// norm_cards: art329_sec2.theft_exception_ownership_or_self_possession
rel theft_conflict(case_id, defendant_id, "art329_sec2.theft_exception_ownership_or_self_possession") = assess_art329_sec2_theft_exception_ownership_or_self_possession(case_id, positive_001, defendant_id, owner_id, possessor_id, "satisfied") and
  provable(case_id, positive_001) and
  assess_art329_sec2_theft_exception_ownership_or_self_possession(case_id, negative_001, defendant_id, owner_id, possessor_id, "not_satisfied") and
  provable(case_id, negative_001)

// rule_id: theft.art329_sec2.card.001.not_satisfied
// sources: comm_001692_제329조_Ⅱ_1
// norm_cards: art329_sec2.theft_exception_ownership_or_self_possession
rel not_satisfied_satisfied_art329_sec2_theft_exception_ownership_or_self_possession(case_id, defendant_id, owner_id, possessor_id) = assess_art329_sec2_theft_exception_ownership_or_self_possession(case_id, not_satisfied_001, defendant_id, owner_id, possessor_id, "not_satisfied") and
  provable(case_id, not_satisfied_001)

// rule_id: theft.art329_sec2.card.002.satisfied
