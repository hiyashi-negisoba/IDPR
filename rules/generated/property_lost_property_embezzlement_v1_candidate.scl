// norm_cards: art360_sec1_1.offense_definition, art360_sec2_1.subject.unrestricted, art360_sec2_2.lost_possession_property, art360_sec2_2.object, art360_sec2_3.completion_external_expression, art360_sec2_3.embezzlement_act, art360_sec2_3.later_appropriation_intent, art360_sec2_3.mistake_property_status_punishable
rel lost_property_embezzlement_established(case_id, defendant_id, owner_id) = lost_property_embezzlement_elements_satisfied(case_id, defendant_id, owner_id) and
  case_assessment_complete(case_id, defendant_id) and
  ~lost_property_embezzlement_has_negative(case_id, defendant_id) and
  ~lost_property_embezzlement_has_conflict(case_id, defendant_id)

// rule_id: lost_property_embezzlement.art360_sec2_2.boundary_shift.001
// sources: comm_001692_제360조_Ⅱ.2_4
// norm_cards: art360_sec2_2.managed_place_property
rel lost_property_embezzlement_boundary_shift(case_id, defendant_id, "art360_sec2_2.managed_place_property") = satisfied_art360_sec2_2_managed_place_property(case_id, defendant_id, owner_id)

// rule_id: lost_property_embezzlement.art360_sec2_2.boundary_shift.002
// sources: comm_001692_제360조_Ⅱ.2_5
// norm_cards: art360_sec2_2.mistaken_bank_transfer_embezzlement_holding
rel lost_property_embezzlement_boundary_shift(case_id, defendant_id, "art360_sec2_2.mistaken_bank_transfer_embezzlement_holding") = satisfied_art360_sec2_2_mistaken_bank_transfer_embezzlement_holding(case_id, defendant_id, owner_id)

// rule_id: lost_property_embezzlement.art360_sec2_2.boundary_shift.003
