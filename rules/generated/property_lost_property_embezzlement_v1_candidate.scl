rel lost_property_embezzlement_refers_to_crime(case_id, defendant_id, "절도") = satisfied_art360_sec2_2_original_possessor_recovery(case_id, defendant_id, owner_id)

// rule_id: lost_property_embezzlement.art360_sec2_2.refers_to_crime.004
// sources: comm_001692_제360조_Ⅱ.2_6
// norm_cards: art360_sec2_2.public_transport_found_property
rel lost_property_embezzlement_refers_to_crime(case_id, defendant_id, "절도") = satisfied_art360_sec2_2_public_transport_found_property(case_id, defendant_id, owner_id)

// rule_id: lost_property_embezzlement.core.outcome.bridge
// sources: comm_001692_제360조_Ⅰ.1_0, comm_001692_제360조_Ⅱ.1_3, comm_001692_제360조_Ⅱ.2_4, comm_001692_제360조_Ⅱ.2_4, comm_001692_제360조_Ⅱ.3_7, comm_001692_제360조_Ⅱ.3_7, comm_001692_제360조_Ⅱ.3_7, comm_001692_제360조_Ⅱ.3_7
// norm_cards: art360_sec1_1.offense_definition, art360_sec2_1.subject.unrestricted, art360_sec2_2.lost_possession_property, art360_sec2_2.object, art360_sec2_3.completion_external_expression, art360_sec2_3.embezzlement_act, art360_sec2_3.later_appropriation_intent, art360_sec2_3.mistake_property_status_punishable
rel property_crime_established(case_id, "lost_property_embezzlement", defendant_id, owner_id, owner_id) = lost_property_embezzlement_established(case_id, defendant_id, owner_id)
