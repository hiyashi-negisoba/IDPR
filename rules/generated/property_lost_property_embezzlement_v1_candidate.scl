// norm_cards: art360_sec2_2.original_possessor_recovery
rel lost_property_embezzlement_boundary_shift(case_id, defendant_id, "art360_sec2_2.original_possessor_recovery") = satisfied_art360_sec2_2_original_possessor_recovery(case_id, defendant_id, owner_id)

// rule_id: lost_property_embezzlement.art360_sec2_2.boundary_shift.004
// sources: comm_001692_제360조_Ⅱ.2_6
// norm_cards: art360_sec2_2.public_transport_found_property
rel lost_property_embezzlement_boundary_shift(case_id, defendant_id, "art360_sec2_2.public_transport_found_property") = satisfied_art360_sec2_2_public_transport_found_property(case_id, defendant_id, owner_id)

// rule_id: lost_property_embezzlement.art360_sec2_2.refers_to_crime.001
// sources: comm_001692_제360조_Ⅱ.2_4
// norm_cards: art360_sec2_2.managed_place_property
rel lost_property_embezzlement_refers_to_crime(case_id, defendant_id, "절도") = satisfied_art360_sec2_2_managed_place_property(case_id, defendant_id, owner_id)

// rule_id: lost_property_embezzlement.art360_sec2_2.refers_to_crime.002
// sources: comm_001692_제360조_Ⅱ.2_5
// norm_cards: art360_sec2_2.mistaken_bank_transfer_embezzlement_holding
rel lost_property_embezzlement_refers_to_crime(case_id, defendant_id, "횡령") = satisfied_art360_sec2_2_mistaken_bank_transfer_embezzlement_holding(case_id, defendant_id, owner_id)

// rule_id: lost_property_embezzlement.art360_sec2_2.refers_to_crime.003
// sources: comm_001692_제360조_Ⅱ.2_4, comm_001692_제360조_Ⅱ.2_4
