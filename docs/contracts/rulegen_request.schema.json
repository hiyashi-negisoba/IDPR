{
  "$id": "idpr/RulegenRequest",
  "description": "One metadata-bounded commentary batch sent to an API model.",
  "type": "object",
  "required": [
    "request_id",
    "task",
    "issue_tag",
    "target",
    "batch",
    "commentary_chunks",
    "constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "task": { "const": "extract_norm_candidates" },
    "issue_tag": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["law_id", "article_no", "article_title"],
      "additionalProperties": false,
      "properties": {
        "law_id": { "type": "string" },
        "article_no": { "type": "string" },
        "article_title": { "type": "string" }
      }
    },
    "batch": {
      "type": "object",
      "required": ["index", "count", "section_paths", "n_chars"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "section_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "n_chars": { "type": "integer", "minimum": 1 }
      }
    },
    "commentary_chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "comment_id",
          "section_path",
          "section_title",
          "document_text"
        ],
        "additionalProperties": false,
        "properties": {
          "comment_id": { "type": "string" },
          "section_path": { "type": "string" },
          "section_title": { "type": "string" },
          "document_text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "source_refs_must_be_exact",
        "preserve_disagreements",
        "legal_status",
        "output_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "source_refs_must_be_exact": { "const": true },
        "preserve_disagreements": { "const": true },
        "legal_status": { "const": "draft" },
        "output_schema": { "const": "idpr/NormCandidateBatch" }
      }
    }
  }
}
