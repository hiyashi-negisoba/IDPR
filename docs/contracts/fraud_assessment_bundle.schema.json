{
  "$id": "idpr/FraudAssessmentBundle",
  "description": "Neural stage 2 output over a host-selected fraud assessment plan.",
  "type": "object",
  "required": ["version", "case_id", "selected_card_ids", "assessments"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "selected_card_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "assessment_id",
          "card_id",
          "status",
          "basis_fact_ids",
          "counter_fact_ids",
          "missing_facts",
          "authority_comment_ids",
          "rationale",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "assessment_id": {
            "type": "string",
            "pattern": "^assessment_[0-9]{3}$"
          },
          "card_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["satisfied", "not_satisfied", "unknown"] },
          "basis_fact_ids": {
            "type": "array",
            "maxItems": 24,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^fact_[0-9]{3}$" }
          },
          "counter_fact_ids": {
            "type": "array",
            "maxItems": 24,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^fact_[0-9]{3}$" }
          },
          "missing_facts": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "authority_comment_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
