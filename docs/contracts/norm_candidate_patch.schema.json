{
  "$id": "idpr/NormCandidatePatch",
  "description": "Adjudicated minimal patch for a validated NormCandidateBatch.",
  "type": "object",
  "required": [
    "version",
    "patch_id",
    "target_id",
    "status",
    "remove_candidate_ids",
    "add_candidates",
    "append_unresolved_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "patch_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "target_id": { "type": "string", "minLength": 1 },
    "status": { "const": "draft" },
    "remove_candidate_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
      "uniqueItems": true
    },
    "add_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "append_unresolved_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["comment_id", "section_path", "quote"],
      "additionalProperties": false,
      "properties": {
        "comment_id": { "type": "string", "minLength": 1 },
        "section_path": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "norm_kind",
        "polarity",
        "proposition",
        "source_refs",
        "review_required"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "norm_kind": { "enum": ["element", "definition", "causal_link", "exception", "standard", "variant"] },
        "polarity": { "enum": ["positive", "negative", "exception"] },
        "proposition": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_ref" }
        },
        "review_required": { "type": "boolean" }
      }
    }
  }
}
