{
  "$id": "idpr/PredicateInstance",
  "description": "S1 output: one extracted predicate instance grounded in source text.",
  "type": "object",
  "required": ["predicate_id", "args", "confidence", "evidence_span"],
  "additionalProperties": false,
  "properties": {
    "predicate_id": { "type": "string" },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_span": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
