{
  "$id": "idpr/RuleIR",
  "description": "Validated intermediate representation compiled to Scallop, never raw model code.",
  "type": "object",
  "required": [
    "version",
    "rule_set_id",
    "issue_tag",
    "status",
    "legal_review",
    "source_scope",
    "norm_card_scope",
    "predicates",
    "rules",
    "legal_review_questions",
    "coverage_gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.1.0" },
    "rule_set_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
    "issue_tag": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "status": { "const": "draft" },
    "legal_review": { "const": "pending" },
    "source_scope": {
      "type": "object",
      "required": ["target_paths", "comment_ids"],
      "additionalProperties": false,
      "properties": {
        "target_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "comment_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "norm_card_scope": {
      "type": "object",
      "required": ["card_set_id", "card_ids"],
      "additionalProperties": false,
      "properties": {
        "card_set_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "card_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "uniqueItems": true
        }
      }
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/predicate" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "legal_review_questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverage_gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["comment_id", "section_path", "quote"],
      "additionalProperties": false,
      "properties": {
        "comment_id": { "type": "string", "minLength": 1 },
        "section_path": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "argument": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["variable", "string", "boolean"] },
        "value": {}
      }
    },
    "atom": {
      "type": "object",
      "required": ["predicate", "arguments", "negated"],
      "additionalProperties": false,
      "properties": {
        "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/argument" }
        },
        "negated": { "type": "boolean" }
      }
    },
    "predicate": {
      "type": "object",
      "required": [
        "id",
        "arguments",
        "kind",
        "role",
        "origin",
        "definition",
        "source_refs",
        "norm_card_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "type": { "enum": ["String", "bool"] }
            }
          }
        },
        "kind": { "enum": ["rule", "standard"] },
        "role": { "enum": ["input", "derived", "policy"] },
        "origin": { "enum": ["commentary", "system"] },
        "definition": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_ref" }
        },
        "norm_card_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "uniqueItems": true
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "head",
        "body",
        "source_refs",
        "norm_card_ids",
        "review_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "head": { "$ref": "#/$defs/atom" },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/atom" }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_ref" }
        },
        "norm_card_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "uniqueItems": true
        },
        "review_notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
