{
  "$id": "idpr/FraudFactGraph",
  "description": "Neural stage 1 output for one fraud issue, grounded in the supplied case text.",
  "type": "object",
  "required": [
    "version",
    "case_id",
    "target_issue_id",
    "actors",
    "facts",
    "profiles",
    "retrieval_queries",
    "unresolved_questions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$" },
    "target_issue_id": { "const": "fraud" },
    "actors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["entity_id", "mentions", "roles"],
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "mentions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "roles": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "defendant",
                "deceived_person",
                "disposer",
                "property_owner",
                "beneficiary"
              ]
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "fact_kind",
          "statement",
          "source_quote",
          "participants",
          "epistemic_status",
          "issue_effects"
        ],
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^fact_[0-9]{3}$"
          },
          "fact_kind": {
            "enum": [
              "representation",
              "true_purpose",
              "mistake",
              "disposition",
              "transfer",
              "intent",
              "relationship",
              "other"
            ]
          },
          "statement": { "type": "string", "minLength": 1 },
          "source_quote": { "type": "string", "minLength": 1 },
          "participants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          },
          "epistemic_status": {
            "enum": ["given", "asserted_by_actor", "disputed", "unknown"]
          },
          "issue_effects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["issue_id", "direction"],
              "additionalProperties": false,
              "properties": {
                "issue_id": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["supports", "rebuts", "neutral"] }
              }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 0,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
                "loan_purpose",
                "loan_repayment",
                "contract_performance",
                "triangular",
                "third_party_acquisition",
                "omission",
                "implicit_deception",
                "advertising",
                "rights_exercise",
                "property_benefit",
                "litigation"
        ]
      }
    },
    "retrieval_queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolved_questions": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
